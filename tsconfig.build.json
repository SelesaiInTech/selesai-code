{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"sourceMap": false,
		"declarationMap": false,
		"inlineSources": false
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist", "src/extensions", "src/themes", "src/__tests__"]
}