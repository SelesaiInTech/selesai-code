---
import { capabilities, type Category, type Distribution } from "../data/capabilities.ts";

export interface Props {
  category: Category;
  locale: "en" | "id";
  distribution?: "bundled" | "optional" | "core";
}

const { category, locale, distribution = "bundled" } = Astro.props;
const items = capabilities.filter(
  (capability) =>
    capability.category === category && capability.distribution === distribution
);

const statusLabels: Record<Distribution, string> = {
  bundled: locale === "en" ? "bundled" : "bundel",
  optional: locale === "en" ? "optional" : "opsional",
  core: locale === "en" ? "core" : "inti",
};
---

{items.length > 0 && (
  <ul class="capability-list">
    {items.map((capability) => {
      const path = locale === "en" ? capability.guideRoute : `id/${capability.guideRoute}`;
      const comparisonBadge =
        capability.piComparison === "core-differentiator"
          ? locale === "en" ? "Selesai difference" : "Perbedaan Selesai"
          : capability.piComparison === "bundled"
            ? locale === "en" ? "Bundled" : "Dibundel"
            : locale === "en" ? "Ergonomics" : "Ergonomi";
      return (
        <li>
          <a href={`${import.meta.env.BASE_URL}${path}/`}>
            <strong>
              {capability[locale].displayName}
              {capability.distribution !== "bundled" && <span class="status-badge" data-distribution={capability.distribution}>{statusLabels[capability.distribution]}</span>}
              <span class="comparison-badge" data-comparison={capability.piComparison}>{comparisonBadge}</span>
            </strong>
            <span>{capability[locale].benefit}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      );
    })}
  </ul>
)}

<style>
  .capability-list {
    margin: 1rem 0 2.5rem;
    padding: 0;
    border-top: 1px solid var(--selesai-border);
    list-style: none;
  }

  li {
    margin: 0;
    border-bottom: 1px solid var(--selesai-border);
  }

  a {
    display: grid;
    grid-template-columns: minmax(10rem, 0.65fr) 1.35fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0.25rem;
    color: var(--sl-color-text);
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  a:hover,
  a:focus-visible {
    background: var(--selesai-surface-raised);
  }

  a:active {
    transform: scale(0.995);
  }

  strong {
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .status-badge {
    font-size: var(--sl-text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.08rem 0.4rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    color: var(--selesai-status-ok);
  }

  .status-badge[data-distribution="optional"] {
    color: var(--selesai-status-warn);
  }
  .status-badge[data-distribution="core"] {
    color: var(--sl-color-text-accent);
  }

  .comparison-badge {
    font-size: var(--sl-text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.08rem 0.4rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    color: var(--sl-color-gray-2);
  }

  .comparison-badge[data-comparison="core-differentiator"] {
    color: var(--sl-color-text-accent);
    background: var(--sl-color-accent-low);
  }

  .comparison-badge[data-comparison="bundled"] {
    color: var(--selesai-status-ok);
  }

  a > span:not(.arrow) {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }

  .arrow {
    color: var(--sl-color-text-accent);
    transition: transform 150ms ease;
  }

  a:hover strong,
  a:focus-visible strong {
    color: var(--sl-color-text-accent);
  }

  a:hover .arrow {
    transform: translateX(0.2rem);
  }

  @media (max-width: 40rem) {
    a {
      grid-template-columns: 1fr auto;
    }

    a > span:not(.arrow) {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
