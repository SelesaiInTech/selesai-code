---
import { capabilities } from "../data/capabilities.ts";

export interface Props {
  locale: "en" | "id";
}

const { locale } = Astro.props;
const bundled = capabilities.filter((c) => c.distribution === "bundled");
const optional = capabilities.filter((c) => c.distribution === "optional");

const labels = locale === "en"
  ? {
      capability: "Capability",
      status: "Status",
      bundled: "Bundled",
      optional: "Optional",
      paths: "Source paths",
      links: "Evidence links",
      optionalSection: "Optional extensions",
      optionalHint: "These extensions are available but not loaded automatically. Install or enable them separately before use.",
    }
  : {
      capability: "Kemampuan",
      status: "Status",
      bundled: "Bundel",
      optional: "Opsional",
      paths: "Jalur source",
      links: "Tautan bukti",
      optionalSection: "Ekstensi opsional",
      optionalHint: "Ekstensi berikut tersedia tetapi tidak dimuat otomatis. Pasang atau aktifkan secara terpisah sebelum digunakan.",
    };
---

<div class="evidence-table-wrap not-content">
  <table class="evidence-table">
    <thead>
      <tr>
        <th scope="col">{labels.capability}</th>
        <th scope="col">{labels.status}</th>
        <th scope="col">{labels.paths}</th>
        <th scope="col">{labels.links}</th>
      </tr>
    </thead>
    <tbody>
      {bundled.map((capability) => (
        <tr class="evidence-row--bundled">
          <th scope="row" data-label={labels.capability}>{capability[locale].displayName}</th>
          <td data-label={labels.status}>
            <span class={"status-pill is-bundled"}>{labels.bundled}</span>
          </td>
          <td data-label={labels.paths}>
            <ul class="path-list">
              {capability.sourcePaths.map((path) => <li><code>{path}</code></li>)}
            </ul>
          </td>
          <td data-label={labels.links}>
            <ul class="link-list">
              {capability.sourceLinks.map((link) => (
                <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.text}</a></li>
              ))}
            </ul>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

{optional.length > 0 && (
  <>
    <h3>{labels.optionalSection}</h3>
    <p>{labels.optionalHint}</p>
    <div class="evidence-table-wrap not-content is-optional-section">
      <table class="evidence-table">
        <thead>
          <tr>
            <th scope="col">{labels.capability}</th>
            <th scope="col">{labels.status}</th>
            <th scope="col">{labels.paths}</th>
            <th scope="col">{labels.links}</th>
          </tr>
        </thead>
        <tbody>
          {optional.map((capability) => (
            <tr class="evidence-row--optional">
              <th scope="row" data-label={labels.capability}>{capability[locale].displayName}</th>
              <td data-label={labels.status}>
                <span class={"status-pill is-optional"}>{labels.optional}</span>
              </td>
              <td data-label={labels.paths}>
                <ul class="path-list">
                  {capability.sourcePaths.map((path) => <li><code>{path}</code></li>)}
                </ul>
              </td>
              <td data-label={labels.links}>
                <ul class="link-list">
                  {capability.sourceLinks.map((link) => (
                    <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.text}</a></li>
                  ))}
                </ul>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </>
)}

<style>
  .evidence-table-wrap {
    margin-block: 1.5rem 2.5rem;
    overflow: hidden;
    border: 1px solid var(--selesai-border);
    border-radius: 1rem;
    background: var(--selesai-surface);
  }

  .evidence-table-wrap.is-optional-section {
    border-inline-start: 4px solid var(--selesai-status-warn);
  }

  .evidence-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }

  h3 {
    margin: 2rem 0 0.5rem;
    font-size: var(--sl-text-lg);
  }

  .status-pill {
    display: inline-block;
    font-size: var(--sl-text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    color: var(--selesai-status-ok);
  }

  .status-pill.is-optional {
    color: var(--selesai-status-warn);
  }

  th,
  td {
    padding: 1rem;
    border-bottom: 1px solid var(--selesai-border);
    text-align: start;
    vertical-align: top;
  }

  thead {
    background: var(--sl-color-accent-low);
  }

  thead th {
    color: var(--sl-color-text-accent);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  tbody tr {
    transition: background-color 180ms ease;
  }

  tbody tr:hover {
    background: var(--selesai-surface-raised);
  }

  tbody th {
    width: 22%;
    color: var(--sl-color-white);
    font-weight: 700;
  }

  tbody tr:last-child > * {
    border-bottom: 0;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: 0.45rem;
  }

  code {
    overflow-wrap: anywhere;
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
  }

  a {
    color: var(--sl-color-text-accent);
    font-weight: 650;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 48rem) {
    .evidence-table-wrap {
      overflow: visible;
      border: 0;
      background: transparent;
    }

    .evidence-table-wrap.is-optional-section {
      border: 0;
      border-inline-start: 4px solid var(--selesai-status-warn);
    }

    .evidence-table,
    .evidence-table tbody,
    .evidence-table tr,
    .evidence-table th,
    .evidence-table td {
      display: block;
      width: 100%;
    }

    .evidence-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .evidence-table tr {
      margin-bottom: 1rem;
      overflow: hidden;
      border: 1px solid var(--selesai-border);
      border-radius: 0.8rem;
      background: var(--selesai-surface);
    }

    .evidence-table th,
    .evidence-table td {
      padding: 0.85rem 1rem;
      border-bottom: 1px solid var(--selesai-border);
    }

    .evidence-table th::before,
    .evidence-table td::before {
      display: block;
      margin-bottom: 0.35rem;
      color: var(--sl-color-gray-3);
      content: attr(data-label);
      font-size: 0.65rem;
      font-weight: 750;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
  }
</style>
