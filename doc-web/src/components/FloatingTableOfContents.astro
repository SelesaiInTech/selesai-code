---
import TableOfContents from "@astrojs/starlight/components/TableOfContents.astro";
---

<div class="floating-toc is-collapsed" data-floating-toc>
  <button class="floating-toc__toggle" type="button" aria-expanded="false" aria-label="Show table of contents" title="Show table of contents">
    <svg class="floating-toc__close-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
    <svg class="floating-toc__list-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01" /></svg>
    <span class="floating-toc__reveal-label">On this page</span>
    <span class="floating-toc__reveal-arrow" aria-hidden="true">›</span>
  </button>
  <div class="floating-toc__content">
    <TableOfContents />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-floating-toc]").forEach((toc) => {
    const button = toc.querySelector<HTMLButtonElement>(".floating-toc__toggle");
    if (!button) return;

    const setOpen = (open: boolean) => {
      toc.classList.toggle("is-collapsed", !open);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Hide table of contents" : "Show table of contents");
      button.title = open ? "Hide table of contents" : "Show table of contents";
    };

    toc.addEventListener("mouseenter", () => setOpen(true));
    toc.addEventListener("mouseleave", () => setOpen(false));
    toc.addEventListener("focusin", () => setOpen(true));
    toc.addEventListener("focusout", () => {
      requestAnimationFrame(() => { if (!toc.contains(document.activeElement)) setOpen(false); });
    });
  });
</script>
