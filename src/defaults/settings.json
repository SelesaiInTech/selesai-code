{
  "autoHandoff": {
    "enabled": true,
    "thresholdTokens": 256000
  },
  "collapseChangelog": true,
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 32000,
    "reserveTokens": 64000
  },
  "defaultModel": "celestial-pro",
  "defaultProvider": "tokenin",
  "defaultThinkingLevel": "high",
  "doubleEscapeAction": "tree",
  "editorPaddingX": 0,
  "outputPad": 0,
  "showCacheMissNotices": false,
  "followUpMode": "one-at-a-time",
  "hideThinkingBlock": false,
  "images": {
    "autoResize": true,
    "imageCaptionModel": "tokenin/qwen3.8-27b",
    "imageCaptionContextTokens": 16384
  },
  "quietStartup": true,
  "retry": {
    "enabled": true,
    "maxRetries": 10
  },
  "steeringMode": "all",
  "terminal": {
    "clearOnShrink": false,
    "showImages": true
  },
  "subagents": {
    "agentOverrides": {
      "architect": {
        "model": "tokenin/celestial-max:max"
      },
      "builder": {
        "model": "tokenin/celestial-max:max"
      },
      "commentator": {
        "model": "tokenin/celestial-pro:max"
      },
      "explorer": {
        "model": "tokenin/celestial-pro:max"
      },
      "recapper": {
        "model": "tokenin/celestial-pro:max"
      },
      "researcher": {
        "model": "tokenin/celestial-pro:max"
      }
    }
  },
  "theme": "dark",
  "transport": "websocket",
  "treeFilterMode": "no-tools"
}
