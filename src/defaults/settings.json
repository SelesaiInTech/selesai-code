{
  "autoHandoff": {
    "enabled": false,
    "thresholdTokens": 128000
  },
  "collapseChangelog": true,
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 32000,
    "reserveTokens": 64000
  },
  "defaultModel": "glm-5.2",
  "defaultProvider": "tokenin",
  "defaultThinkingLevel": "high",
  "doubleEscapeAction": "tree",
  "editorPaddingX": 1,
  "enableSkillCommands": true,
  "followUpMode": "one-at-a-time",
  "hideThinkingBlock": false,
  "images": {
    "autoResize": true
  },
  "lastChangelogVersion": "0.80.2",
  "packages": [
    "git:github.com/MasuRii/pi-tool-display",
    "git:github.com/omaclaren/pi-markdown-preview",
    "git:github.com/aliou/pi-guardrails"
  ],
  "quietStartup": true,
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "steeringMode": "all",
  "terminal": {
    "clearOnShrink": false,
    "showImages": true
  },
  "theme": "dark",
  "transport": "websocket",
  "treeFilterMode": "no-tools"
}
