{
  "autoHandoff": {
    "enabled": true,
    "thresholdTokens": 256000
  },
  "collapseChangelog": true,
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 32000,
    "reserveTokens": 64000
  },
  "defaultModel": "auto-premium",
  "defaultProvider": "tokenin",
  "defaultThinkingLevel": "max",
  "doubleEscapeAction": "tree",
  "editorPaddingX": 0,
  "outputPad": 0,
  "showCacheMissNotices": false,
  "followUpMode": "one-at-a-time",
  "hideThinkingBlock": false,
  "images": {
    "autoResize": true
  },
  "packages": [
    "git:github.com/MasuRii/pi-tool-display",
    "git:github.com/omaclaren/pi-markdown-preview"
  ],
  "pruneToolDescriptions": true,
  "quietStartup": true,
  "retry": {
    "enabled": true,
    "maxRetries": 10
  },
  "steeringMode": "all",
  "terminal": {
    "clearOnShrink": false,
    "showImages": true
  },
  "powerline": {
    "cache_read": { "format": "both" }
  },
  "subagents": {
    "agentOverrides": {
      "architect": {
        "model": "tokenin/auto-premium:max"
      },
      "builder": {
        "model": "tokenin/auto-premium:max"
      },
      "commentator": {
        "model": "tokenin/auto-premium:max"
      },
      "explorer": {
        "model": "tokenin/auto:max"
      },
      "recapper": {
        "model": "tokenin/auto:max"
      },
      "researcher": {
        "model": "tokenin/auto:max"
      }
    }
  },
  "theme": "dark",
  "transport": "websocket",
  "treeFilterMode": "no-tools"
}
