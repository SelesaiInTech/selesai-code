{
  "autoHandoff": {
    "enabled": false,
    "thresholdTokens": 128000
  },
  "collapseChangelog": true,
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 32000,
    "reserveTokens": 64000
  },
  "defaultModel": "glm-5.2",
  "defaultProvider": "tokenin",
  "defaultThinkingLevel": "high",
  "doubleEscapeAction": "tree",
  "editorPaddingX": 0,
  "outputPad": 0,
  "showCacheMissNotices": true,
  "followUpMode": "one-at-a-time",
  "hideThinkingBlock": false,
  "images": {
    "autoResize": true
  },
  "lastChangelogVersion": "0.80.2",
  "packages": [
    "git:github.com/MasuRii/pi-tool-display",
    "git:github.com/omaclaren/pi-markdown-preview"
  ],
  "quietStartup": true,
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "steeringMode": "all",
  "terminal": {
    "clearOnShrink": false,
    "showImages": true
  },
  "subagents": {
    "agentOverrides": {
      "architect": {
        "model": "tokenin/kimi-k3:high"
      },
      "builder": {
        "model": "tokenin/deepseek-v4-flash:max"
      },
      "commentator": {
        "model": "tokenin/deepseek-v4-flash:max"
      },
      "explorer": {
        "model": "tokenin/deepseek-v4-flash:max"
      },
      "recapper": {
        "model": "tokenin/deepseek-v4-flash:max"
      },
      "researcher": {
        "model": "tokenin/deepseek-v4-flash:max"
      }
    }
  },
  "theme": "dark",
  "transport": "websocket",
  "treeFilterMode": "no-tools"
}
